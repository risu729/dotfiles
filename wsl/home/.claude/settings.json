{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"attribution": {
		"commit": "",
		"pr": "",
		"sessionUrl": false
	},
	"effortLevel": "high",
	"fastMode": false,
	"hooks": {
		"SessionStart": [
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "bash '/home/risu/.claude/hooks/herdr-agent-state.sh' session",
						"timeout": 10
					}
				]
			}
		]
	},
	"permissions": {
		"defaultMode": "bypassPermissions"
	},
	"remoteControlAtStartup": true,
	"skipDangerousModePermissionPrompt": true,
	"statusLine": {
		"type": "command",
		"command": "ccusage statusline"
	},
	"theme": "auto"
}
