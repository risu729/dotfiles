# ~/.config/zsh/zshrc: sourced from ~/.zshrc, which mise bootstrap manages with
# a single block so that machine-local lines there survive. The zsh counterpart
# of ~/.bashrc, for macOS.

# Keep PATH, fpath, and the hook arrays free of duplicates when this file is
# sourced again; pitchfork's activation appends to chpwd_functions blindly.
typeset -U path fpath chpwd_functions precmd_functions

# The mise installer puts mise in ~/.local/bin, and mise pours Homebrew formulae
# into /opt/homebrew; neither is on the default macOS PATH.
export PATH="${HOME}/.local/bin:/opt/homebrew/bin:${PATH}"

# Completion. mise links the completions of poured formulae and installed casks
# into the Homebrew prefix, like Homebrew itself. This runs before mise is
# activated because activation runs compinit itself when compdef is missing,
# with the default dump file instead of the one below.
if [[ -o interactive ]]; then
	fpath=(/opt/homebrew/share/zsh/site-functions "${fpath[@]}")
	autoload -Uz compinit bashcompinit
	mkdir -p "${XDG_CACHE_HOME:-${HOME}/.cache}/zsh"
	compinit -d "${XDG_CACHE_HOME:-${HOME}/.cache}/zsh/zcompdump"
	bashcompinit
	zstyle ':completion:*' menu select
	zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
fi

# Activate mise. This also defines the shell aliases from the global config.
if command -v mise >/dev/null 2>&1; then
	eval "$(mise activate zsh)"
fi

# If not running interactively, skip other steps
[[ -o interactive ]] || return 0

# VS Code resolves the shell environment with an interactive shell
# ref: https://code.visualstudio.com/docs/editor/command-line#_how-do-i-detect-when-a-shell-was-launched-by-vs-code
if [[ ${VSCODE_RESOLVING_ENVIRONMENT:-} == 1 ]]; then
	return 0
fi

# History
HISTFILE="${HOME}/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS SHARE_HISTORY

# Tools that generate their own zsh completion. Each script registers itself
# with compdef, so they run after compinit.
if command -v mise >/dev/null 2>&1; then
	eval "$(mise completion zsh)"
fi
if command -v gh >/dev/null 2>&1; then
	eval "$(gh completion --shell zsh)"
fi
# ref: https://kubernetes.io/docs/reference/kubectl/generated/kubectl_completion/
if command -v kubectl >/dev/null 2>&1; then
	eval "$(kubectl completion zsh)"
fi
# kubecolor shares kubectl's completion. The `k` alias expands to kubecolor
# before completion.
# ref: https://kubecolor.github.io/setup/shells/zsh/
if command -v kubectl >/dev/null 2>&1 && command -v kubecolor >/dev/null 2>&1; then
	compdef kubecolor=kubectl
fi
# ref: https://mikefarah.gitbook.io/yq/v/v4.x/commands/shell-completion
if command -v yq >/dev/null 2>&1; then
	eval "$(yq shell-completion zsh)"
fi
# ref: https://hk.jdx.dev/cli/completion.html
if command -v hk >/dev/null 2>&1; then
	eval "$(hk completion zsh)"
fi
if command -v pitchfork >/dev/null 2>&1; then
	eval "$(pitchfork completion zsh)"
fi
# ghr only generates bash completion, which zsh loads through bashcompinit.
if command -v ghr >/dev/null 2>&1; then
	eval "$(ghr shell bash --completion)"
fi

# `ghr shell` has no zsh variant, so this ports the wrapper from .bashrc: `ghr cd`
# picks a repository with fzf when no argument is given, and `--cd` after
# `clone` or `init` enters the new repository. `command ghr` skips the wrapper.
if command -v ghr >/dev/null 2>&1; then
	__ghr_cd() {
		local repo_path selected

		if (($# > 0)); then
			repo_path=$(command ghr path "$@") || return
			cd "${repo_path}" || return
			return
		fi

		if ! command -v fzf >/dev/null 2>&1; then
			print -u2 'error: fzf is required for interactive ghr cd'
			return 1
		fi

		selected=$(
			paste <(command ghr list) <(command ghr list --path) |
				fzf --prompt='ghr cd> ' --height=80% --reverse --with-nth=1
		) || return
		[[ -n ${selected} ]] || return 1
		repo_path=${selected#*$'\t'}
		[[ -n ${repo_path} ]] || return 1
		cd "${repo_path}" || return
	}
	ghr() {
		local arg has_cd=false
		local -a cd_args

		for arg in "$@"; do
			if [[ ${arg} == "-h" || ${arg} == "--help" ]]; then
				command ghr "$@"
				return
			fi
		done

		if (($# > 0)); then
			case "$1" in
			cd)
				shift
				__ghr_cd "$@"
				return
				;;
			clone | init)
				for arg in "${@:2}"; do
					if [[ ${arg} == "--cd" ]]; then
						has_cd=true
					else
						cd_args+=("${arg}")
					fi
				done
				if [[ ${has_cd} == true ]]; then
					command ghr "$@" || return
					__ghr_cd "${cd_args[@]}"
					return
				fi
				;;
			esac
		fi

		command ghr "$@"
	}
fi

# Activate zoxide
if command -v zoxide >/dev/null 2>&1; then
	eval "$(zoxide init zsh --cmd z)"
fi

# Activate pitchfork
if command -v pitchfork >/dev/null 2>&1; then
	eval "$(pitchfork activate zsh)"
fi

# Set GITHUB_TOKEN to avoid rate limit while using mise
# Use __CI instead of CI to be able to test CI locally
if [[ -z ${__CI:-} ]] && command -v gh >/dev/null 2>&1; then
	github_token=$(gh auth token 2>/dev/null)
	# An empty GITHUB_TOKEN in the environment would still make gh ignore its
	# keyring accounts
	if [[ -n ${github_token} ]]; then
		export GITHUB_TOKEN="${github_token}"
	fi
	unset github_token
fi

# Activate atuin last so that its key bindings win
if command -v atuin >/dev/null 2>&1; then
	eval "$(atuin init zsh --disable-up-arrow)"
fi
