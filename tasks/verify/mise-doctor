#!/usr/bin/env bash
#MISE description="Check mise diagnostics, allowing only deliberately uninstalled lazy tools."
set -euo pipefail

status=0
report=$(MISE_DISABLE_UPDATE_WARNING=1 mise doctor --json) || status=$?
printf '%s\n' "${report}" | bun "$(dirname "${BASH_SOURCE[0]}")/../../mise/doctor/filter.ts" "${status}"
