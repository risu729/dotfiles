#!/usr/bin/env bash
#MISE description="Run installed-machine project diagnostics (TEST_PROFILE=bare|personal)."
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/../.."
case "${TEST_PROFILE:-}" in
bare | personal) ;;
*)
	echo 'Set TEST_PROFILE=bare or personal for installed-machine diagnostics' >&2
	exit 1
	;;
esac
case "$(uname -s)" in
Darwin | Linux) ;;
*)
	echo 'Unsupported bootstrap verification platform' >&2
	exit 1
	;;
esac
exec mise --cd mise/doctor doctor project "$@"
