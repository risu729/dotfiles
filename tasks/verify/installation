#!/usr/bin/env bash
#MISE description="Verify installed dotfiles and mise diagnostics in a fresh interactive shell."
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/../.."
case "$(uname -s)" in
Darwin) login_shell=zsh ;;
Linux) login_shell=bash ;;
*)
	echo 'Unsupported bootstrap verification platform' >&2
	exit 1
	;;
esac
if [[ -n ${GIT_COMMIT_SHA:-} ]]; then
	installed_revision=$(git rev-parse HEAD)
	test "${installed_revision}" = "${GIT_COMMIT_SHA}"
fi
exec "${login_shell}" -ic 'bash tasks/verify/mise-doctor && mise --cd mise/doctor doctor project'
