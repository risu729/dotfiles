#!/usr/bin/env bash
#MISE description="Package or restore the validated Worker bundle without rebuilding it."
#USAGE arg "<operation>" help="pack or restore"
set -euo pipefail

pack_worker() {
	local revision="$1"
	mkdir -p out/worker-artifact
	# Archive hidden files and permissions along with the generated configuration.
	tar -czf out/worker-artifact/worker.tar.gz -C worker .cloudflare/output/v0
	printf '%s\n' "${revision}" >out/worker-artifact/revision
	(cd out/worker-artifact && shasum --algorithm 256 worker.tar.gz >SHA256SUMS)
}

restore_worker() {
	local expected_revision="$1" actual_revision
	actual_revision=$(cat out/worker-artifact/revision) || return
	if [[ ${actual_revision} != "${expected_revision}" ]]; then
		echo 'Worker artifact belongs to a different revision' >&2
		return 1
	fi
	(cd out/worker-artifact && shasum --algorithm 256 --check SHA256SUMS) || return
	tar -xzf out/worker-artifact/worker.tar.gz -C worker || return
	test -f worker/.cloudflare/output/v0/workers/default/bundle/index.js || return
	# cf --prebuilt consumes this output directly and refuses a different mode.
	bun -e '
		const root = await Bun.file("worker/.cloudflare/output/v0/config.json").json();
		const worker = await Bun.file("worker/.cloudflare/output/v0/workers/default/worker.config.json").json();
		if (root.buildContext?.mode !== "production" || root.buildContext?.isPreview !== false) {
			throw new Error("Worker artifact must be built for production");
		}
		if (worker.name !== "dotfiles-worker" || worker.manifest?.mainModule !== "index.js") {
			throw new Error("Worker artifact has an unexpected Worker or entrypoint");
		}
	'
}

main() {
	local revision
	cd "$(dirname "${BASH_SOURCE[0]}")/../.."
	revision=$(git rev-parse HEAD)
	case "${1:?Expected pack or restore}" in
	pack) pack_worker "${revision}" ;;
	restore) restore_worker "${EXPECTED_REVISION:?Set EXPECTED_REVISION to the validated commit}" ;;
	*)
		echo 'Expected pack or restore' >&2
		return 1
		;;
	esac
}

if [[ ${BASH_SOURCE[0]:-$0} == "$0" ]]; then
	main "$@"
fi
