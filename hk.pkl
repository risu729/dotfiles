amends "https://raw.githubusercontent.com/risu729/hk-config/v1.1.0/presets.pkl"

import "https://raw.githubusercontent.com/risu729/hk-config/v1.1.0/helpers.pkl"

subprojects = List("worker")

local const shellGlobs = List("home/.bashrc", "tests/**/*.bats")

local function includeShellFiles(step: Step): Step = (step) {
  match_any =
    step.match_any!!
      + List(new FileSelector { glob = shellGlobs })
}

local picked =
  helpers.pick(new Listing {
    "oxlint"
    "oxfmt"
    "github-actions"
    "tombi"
    "rumdl"
    "yaml"
    "shfmt"
    "shellcheck"
    "hadolint"
    "mise"
    "lychee"
    "typos"
    "tsc"
    "betterleaks"
    "hygiene"
  })

local mise = picked["mise"] as Group

hooks =
  helpers.standardHooks((picked) {
    // Work around hk 1.58.1's pklr evaluator dropping inherited commands when
    // these preset steps are amended; otherwise hk silently skips the steps.
    // Standard Pkl preserves them. Recheck during the hk v2 upgrade:
    // https://github.com/risu729/dotfiles/pull/4188
    // Remove the duplicate commands once check/fix plans retain the inherited ones.
    ["shfmt"] = (includeShellFiles(picked["shfmt"] as Step)) {
      check_diff = "shfmt --diff --simplify {{ files }}"
      fix = "shfmt --write --simplify {{ files }}"
    }
    ["shellcheck"] = (includeShellFiles(picked["shellcheck"] as Step)) {
      check = "shellcheck --external-sources {{ files }}"
    }
    ["mise"] = (mise) {
      steps {
        ["mise-fmt"] = mise.steps["mise-fmt"]
        ["mise-tasks"] = (mise.steps["mise-tasks"]) {
          // Same hk 1.58.1 pklr inheritance workaround as the shell steps above.
          // Remove with #4188 once this step inherits the preset's check command.
          check = "mise task validate"
          glob =
            List(
              "tasks.toml",
              "tasks/**",
              "worker/tasks.toml",
              "worker/tasks/**",
              "mise.toml",
              "mise/**",
            )
        }
      }
    }
    ["pwsh"] = new Step {
      // batch=false: ScriptAnalyzer scans `win/` recursively; command has no `{{ files }}`
      batch = false
      glob = List("win/**/*.ps1", "win/**/*.psd1", "win/**/*.psm1")
      check =
        "pwsh -NoProfile -Command 'Invoke-ScriptAnalyzer -Path win -Recurse -EnableExit -Settings win/PSScriptAnalyzerSettings.psd1'"
    }
  })
