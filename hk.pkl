amends "https://raw.githubusercontent.com/risu729/hk-config/v3.0.0/presets.pkl"

import "https://raw.githubusercontent.com/risu729/hk-config/v3.0.0/helpers.pkl"

subprojects = List("worker")

local const shellGlobs = List("unix/home/.bashrc", "tests/**/*.bats")

local function includeShellFiles(step: Step): Step = (step) {
  match_any =
    step.match_any!!
      + List(new FileSelector { glob = shellGlobs })
}

local picked =
  helpers.pick(new Listing {
    "oxlint"
    "oxfmt"
    "github-actions"
    "tombi"
    "rumdl"
    "yaml"
    "shfmt"
    "shellcheck"
    "hadolint"
    "mise"
    "lychee"
    "typos"
    "tsc"
    "betterleaks"
    "hygiene"
  })

local mise = picked["mise"] as Group
local yaml = picked["yaml"] as Group

steps = (picked) {
  ["oxfmt"] = (picked["oxfmt"]) {
    // Preserve the manifests covered by native mise dependency graph digests.
    exclude =
      (picked["oxfmt"] as Step).exclude!!
        + List(".mise/locks/**/package.json", "unix/home/.config/mise/locks/**/package.json")
  }
  ["shfmt"] = includeShellFiles(picked["shfmt"] as Step)
  ["shellcheck"] = includeShellFiles(picked["shellcheck"] as Step)
  ["yaml"] = (yaml) {
    steps = (yaml.steps) {
      // Native mise dependency graphs are generated and checksum-locked.
      ["yamllint"] = (yaml.steps["yamllint"]) {
        exclude = (yaml.steps["yamllint"] as Step).exclude!! + List("**/aube-lock.yaml")
      }
      ["yamlfmt"] = (yaml.steps["yamlfmt"]) {
        exclude = (yaml.steps["yamlfmt"] as Step).exclude!! + List("**/aube-lock.yaml")
      }
    }
  }
  ["mise"] = (mise) {
    steps {
      ["mise-fmt"] = mise.steps["mise-fmt"]
      ["mise-tasks"] = (mise.steps["mise-tasks"]) {
        // Preserve the command while the evaluator drops it from amended custom steps.
        // https://github.com/risu729/hk-config/issues/124
        check = "mise task validate"
        glob =
          List(
            "tasks.toml",
            "tasks/**",
            "worker/tasks.toml",
            "worker/tasks/**",
            "mise.toml",
            "mise/**",
          )
      }
    }
  }
  ["pwsh"] = new Step {
    // batch=false: ScriptAnalyzer scans `win/` recursively; command has no `{{ files }}`
    batch = false
    glob = List("win/**/*.ps1", "win/**/*.psd1", "win/**/*.psm1")
    check =
      "pwsh -NoProfile -Command 'Invoke-ScriptAnalyzer -Path win -Recurse -EnableExit -Settings win/PSScriptAnalyzerSettings.psd1'"
  }
}
