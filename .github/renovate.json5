{
	// ref: https://docs.renovatebot.com/configuration-options/
	$schema: "https://docs.renovatebot.com/renovate-schema.json",
	extends: ["github>risu729/renovate-config#3.19.0"],
	packageRules: [
		// set semantic commit types
		{
			// override the default semanticCommitType, fix for dependencies, to chore
			matchFileNames: ["worker/package.json"],
			semanticCommitType: "chore",
		},
		// add labels
		{
			matchFileNames: ["worker/**"],
			addLabels: ["worker"],
		},
		// refresh the global mise lockfile daily in its own PR, instead of the
		// weekly run shared with every other lockfile.
		// the schedule, timezone, and group name must be nested under
		// lockFileMaintenance because its defaults are re-merged over packageRules
		// afterwards.
		{
			matchFileNames: ["wsl/home/.config/mise/config.toml"],
			matchUpdateTypes: ["lockFileMaintenance"],
			lockFileMaintenance: {
				schedule: ["before 6am"],
				timezone: "Australia/Sydney",
				groupName: "global mise lockfile",
			},
			groupSingleUpdates: true,
		},
	],
	// ref: https://docs.renovatebot.com/modules/manager/regex/#advanced-capture
	customManagers: [
		{
			customType: "jsonata",
			description: "Updates PSScriptAnalyzer version",
			managerFilePatterns: ["/^mise\\.toml$/"],
			fileFormat: "toml",
			datasourceTemplate: "github-releases",
			packageNameTemplate: "PowerShell/PSScriptAnalyzer",
			matchStrings: ['{ "currentValue": vars.PS_SCRIPT_ANALYZER_VERSION }'],
		},
	],
}
