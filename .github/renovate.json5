{
	// ref: https://docs.renovatebot.com/configuration-options/
	$schema: "https://docs.renovatebot.com/renovate-schema.json",
	extends: ["github>risu729/renovate-config#3.21.2"],
	packageRules: [
		// Keep the installer, min_version, CI, schemas, and container tag/digest together.
		{
			matchPackageNames: ["jdx/mise", "ghcr.io/jdx/mise"],
			groupName: "mise",
			groupSingleUpdates: true,
		},
		// set semantic commit types
		{
			// override the default semanticCommitType, fix for dependencies, to chore
			matchFileNames: ["worker/package.json"],
			semanticCommitType: "chore",
		},
		// add labels
		{
			matchFileNames: ["worker/**"],
			addLabels: ["worker"],
		},
		// refresh the global mise lockfile on every Renovate run so frequently
		// released tools such as Codex and Claude are picked up promptly.
		// the schedule and group name must be nested under
		// lockFileMaintenance because its defaults are re-merged over packageRules
		// afterwards.
		{
			matchFileNames: [
				"unix/home/.config/mise/config.toml",
				"unix/home/.config/mise/config.personal.toml",
			],
			matchUpdateTypes: ["lockFileMaintenance"],
			lockFileMaintenance: {
				schedule: ["* * * * *"],
				groupName: "global mise lockfile",
			},
			groupSingleUpdates: true,
		},
		// tools requesting "latest" in the global config also make Renovate
		// open per-tool lockfile-only PRs ("update dependency X to latest") that
		// duplicate the maintenance PR above and get autoclosed whenever it merges
		// first. keep only the bulk maintenance PR.
		{
			matchFileNames: [
				"unix/home/.config/mise/config.toml",
				"unix/home/.config/mise/config.personal.toml",
			],
			matchCurrentValue: "/^latest$/",
			enabled: false,
		},
		// Keep the temporary global Python series pin while native wheels and
		// markitdown catch up; allow 3.14 patch updates.
		// ref: https://github.com/users/risu729/projects/3?pane=issue&itemId=271329713
		{
			matchManagers: ["mise"],
			matchFileNames: ["unix/home/.config/mise/config.toml"],
			matchPackageNames: ["python/cpython"],
			allowedVersions: ">=3.14 <3.15",
		},
	],
	// ref: https://docs.renovatebot.com/modules/manager/jsonata/
	customManagers: [
		// min_version follows every mise release here so new releases that break
		// these dotfiles show up in CI. other repositories raise it by hand.
		{
			customType: "jsonata",
			description: "Updates min_version in mise config",
			managerFilePatterns: [
				// ref: https://docs.renovatebot.com/modules/manager/mise/#file-matching
				"/(^|/)\\.?mise\\.toml$/",
				"/(^|/)\\.?mise/config\\.toml$/",
			],
			fileFormat: "toml",
			datasourceTemplate: "github-releases",
			depNameTemplate: "mise",
			packageNameTemplate: "jdx/mise",
			matchStrings: ['{ "currentValue": $.min_version }'],
		},
		{
			customType: "regex",
			description: "Updates the pinned Unix installer mise version",
			managerFilePatterns: ["/^unix\\/install\\.sh$/"],
			datasourceTemplate: "github-releases",
			packageNameTemplate: "jdx/mise",
			extractVersionTemplate: "^v(?<version>.*)$",
			matchStrings: ['mise_version="(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"'],
		},
		{
			customType: "jsonata",
			description: "Updates pinned mise JSON schemas",
			managerFilePatterns: ["/^tombi\\.toml$/"],
			fileFormat: "toml",
			datasourceTemplate: "github-releases",
			packageNameTemplate: "jdx/mise",
			matchStrings: [
				'schemas.$match(path, /^https:\\/\\/raw\\.githubusercontent\\.com\\/jdx\\/mise\\/(v[0-9]+\\.[0-9]+\\.[0-9]+)\\/schema\\/(mise(?:-task)?)\\.json$/).{ "currentValue": groups[0], "depType": groups[1] }',
			],
		},
		{
			customType: "jsonata",
			description: "Updates PSScriptAnalyzer version",
			managerFilePatterns: ["/^mise\\.toml$/"],
			fileFormat: "toml",
			datasourceTemplate: "github-releases",
			packageNameTemplate: "PowerShell/PSScriptAnalyzer",
			matchStrings: ['{ "currentValue": vars.PS_SCRIPT_ANALYZER_VERSION }'],
		},
	],
}
